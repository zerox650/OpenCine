    <string name="nikon_popup_shutter_locked">Shutter locked on camera. Hold anywhere to unlock.</string>
    <string name="nikon_popup_iso_locked_recording">ISO is locked while recording in R3D NE</string>
    <string name="nikon_popup_auto_iso_on_manual">Auto ISO is on. The camera sets sensitivity. Switch to Manual to choose a value.</string>
    <string name="nikon_popup_manual_iso_needs_modes">Manual ISO needs P, S, A, M or a U bank. The camera is setting sensitivity.</string>
    <string name="nikon_popup_auto_iso_on_off">Auto ISO is on. The camera sets sensitivity. Switch to Auto Off to choose a value.</string>
    <string name="nikon_popup_manual_iso_needs_m">Manual ISO needs exposure mode M. The camera is setting sensitivity.</string>
